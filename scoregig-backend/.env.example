# Copy this file to .env and fill in your real values (never commit .env)

# From https://dashboard.stripe.com/apikeys — use sk_test_... until you're ready for live.
# When you launch, swap this for your LIVE secret key (starts with sk_live_).
STRIPE_SECRET_KEY=sk_test_xxx

# From `stripe listen` (local dev) or your dashboard webhook endpoint settings
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Where the Stripe Connect onboarding flow returns scorekeepers to
APP_URL=http://localhost:5173

# Public URL of THIS backend, used to build the parent/guardian consent link that
# goes in the email to a minor's guardian. In local dev the default is fine; in
# production set it to your real API origin, e.g. https://api.scoregig.ca
API_PUBLIC_URL=http://localhost:4000

PORT=4000

# Secret used to sign login sessions (JWT). This is what proves a logged-in user
# is who they say they are — if it's weak or left as the default, someone could
# forge a login token and impersonate any account (including an admin). Set it to
# a long random string in production (e.g. `openssl rand -base64 48`).
JWT_SECRET=change-me-to-a-long-random-string

# Platform service fee charged to organizers, as a percentage of gig pay
PLATFORM_FEE_PERCENT=15

# Hours to hold funds after a gig is marked complete before auto-release.
# 2 hours gives the organizer a window to report issues (industry standard).
RELEASE_HOLD_HOURS=2

# ---------------------------------------------------------------------------
# NOTIFICATIONS (optional). Leave blank to run in "pending-setup" mode, where
# messages are logged + recorded but not actually sent. Fill these in to go live.
#
# Email — SendGrid (https://app.sendgrid.com → Settings → API Keys).
# SENDGRID_FROM must be a verified sender identity.
SENDGRID_API_KEY=
SENDGRID_FROM=

# SMS — Twilio (https://console.twilio.com). TWILIO_FROM is your Twilio number
# in E.164 format, e.g. +15875551234.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Public URL of THIS backend's Twilio webhook, e.g. https://api.yourdomain.com/webhooks/twilio-sms
# Set it as the "A message comes in" webhook on your Twilio number, and here too
# so inbound STOP/START signatures are verified. Leave blank in local dev.
TWILIO_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# PAYOUT SCHEDULER
# "internal" (default): the app runs the payout job itself on a 1-minute timer.
# "external": disable the built-in timer and instead have a real scheduler
# (cron, cloud scheduler, queue) POST to /internal/run-release every minute.
# Recommended for production so payouts survive restarts and scale cleanly.
RELEASE_SCHEDULER=internal

# Shared secret required (in the x-internal-secret header) to call
# /internal/run-release. Set a long random string if you use external mode.
INTERNAL_API_SECRET=
